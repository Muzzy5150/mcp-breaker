# Stage 5 connects only to the local TrueForge control plane.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5-6-terra
TRUEFORGE_MCP_SERVER=mcpbreakerdemo

# Optional only when the local TrueForge instance requires bearer auth.
# TRUEFORGE_TOKEN=

